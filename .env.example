# =============================================================================
# Configuration - copier en .env et adapter
# =============================================================================
#
#   cp .env.example .env
#
# Toutes les valeurs ci-dessous sont OPTIONNELLES: sans fichier .env, les
# defauts de shared/settings.py s'appliquent et l'application fonctionne.
#
# Convention de nommage (pydantic-settings):
#   TRANSCRIBE_<GROUPE>__<CHAMP>
#   - prefixe    : TRANSCRIBE_
#   - separateur : double underscore __ entre le groupe et le champ
#
# Les valeurs sont validees au demarrage (bornes, enums): une valeur hors
# limites fait echouer le lancement avec un message explicite plutot que de
# produire un comportement silencieusement faux.
#
# ATTENTION: ce fichier est un MODELE, il est versionne. Ne jamais y ecrire de
# secret. Le vrai .env est ignore par git.
# =============================================================================


# --- Modele Whisper ----------------------------------------------------------
# whisper_model : tiny | base | small | medium | large | large-v2 | large-v3
#   tiny/base  -> tres rapide, qualite faible (tests, machines modestes)
#   small      -> bon compromis, ~460 Mo
#   large      -> meilleure qualite, ~3 Go, GPU recommande (defaut)
#TRANSCRIBE_MODEL__WHISPER_MODEL=large

# device : cuda | cpu | auto   (bascule automatiquement sur CPU si pas de GPU)
#TRANSCRIBE_MODEL__DEVICE=cuda

# float_precision : float16 | float32 | int8   (int8 force sur CPU)
#TRANSCRIBE_MODEL__FLOAT_PRECISION=float16

# Code langue de la transcription (fr, en, es, ...)
#TRANSCRIBE_MODEL__LANGUAGE=fr

# Largeur du faisceau de recherche: plus haut = plus precis mais plus lent
#TRANSCRIBE_MODEL__BEAM_SIZE=5


# --- Fonctionnalites (activation / desactivation) ----------------------------
# Couper la transcription: l'application devient un simple visualiseur audio.
#TRANSCRIBE_FEATURES__ENABLE_TRANSCRIPTION=true

# Apercu temps reel pendant que l'on parle (couteux: 2e passe Whisper)
#TRANSCRIBE_FEATURES__ENABLE_PREVIEW=false

# VAD avance (Silero + ZCR). Si false, simple seuil d'energie RMS.
#TRANSCRIBE_FEATURES__ENABLE_ADVANCED_VAD=true

# Detection intelligente de fin de phrase (energie + pitch)
#TRANSCRIBE_FEATURES__ENABLE_PHRASE_DETECTION=true

# Reduction de bruit (experimental, necessite `pip install noisereduce`)
#TRANSCRIBE_FEATURES__ENABLE_NOISE_REDUCTION=false

# Icone dans la zone de notification
#TRANSCRIBE_FEATURES__ENABLE_SYSTEM_TRAY=false


# --- Capture audio -----------------------------------------------------------
# Frequence d'echantillonnage en Hz (Whisper attend 16000)
#TRANSCRIBE_AUDIO__SAMPLE_RATE=16000

# Duree d'un bloc audio en secondes: unite de base de toute la boucle
#TRANSCRIBE_AUDIO__BLOCK_SECONDS=0.5

# Seuil d'energie RMS en dessous duquel on considere qu'il n'y a pas de voix
#TRANSCRIBE_AUDIO__ENERGY_THRESHOLD=0.004

# Duree maximale accumulee avant transcription forcee (garde-fou memoire)
#TRANSCRIBE_AUDIO__MAX_PRODUCTION_SECONDS=30.0


# --- Detection de voix (VAD) -------------------------------------------------
# Seuil de probabilite Silero: plus bas = plus sensible
#TRANSCRIBE_VAD__SILERO_THRESHOLD=0.1

# Filtre par taux de passage par zero (rejette musique et bruits non vocaux)
#TRANSCRIBE_VAD__USE_ZCR_FILTER=true

# Detection adaptative: apprend le bruit ambiant et ajuste les seuils
#TRANSCRIBE_VAD__USE_ADAPTIVE_DETECTION=true

# La voix doit etre X fois plus forte que le bruit ambiant
#TRANSCRIBE_VAD__ADAPTIVE_BOOST_FACTOR=1.2

# Journalisation detaillee du VAD (utile pour regler les seuils)
#TRANSCRIBE_VAD__DEBUG_VAD=true


# --- Serveur SSE (communication coeur <-> interface) -------------------------
# Ecoute en local uniquement. Ne pas exposer sur 0.0.0.0: aucune
# authentification n'est prevue sur ces endpoints.
#TRANSCRIBE_SERVER__HOST=127.0.0.1
#TRANSCRIBE_SERVER__PORT=5433


# --- Veille ------------------------------------------------------------------
# Inactivite avant mise en veille (equivalent a un F9 OFF automatique)
#TRANSCRIBE_SLEEP__AUTO_SLEEP_SECONDS=30.0

# Veille prolongee avant dechargement des modeles de la memoire
#TRANSCRIBE_SLEEP__DEEP_SLEEP_SECONDS=1800.0


# --- Collage du texte --------------------------------------------------------
# Restaurer le contenu du presse-papiers apres le collage
#TRANSCRIBE_PRODUCTION__RESTORE_CLIPBOARD=true

# Ajouter une espace apres le texte colle
#TRANSCRIBE_PRODUCTION__APPEND_SPACE=true


# =============================================================================
# Cles API
# =============================================================================
# Le coeur de l'application ne fait AUCUN appel reseau vers un service tiers:
# Whisper et Silero VAD tournent en local. Aucune cle n'est necessaire.
#
# Le module services/ (integration AutoGen, non active) attend, lui, une
# configuration separee: copier services/config.py.example vers
# services/config.py. Ce fichier est ignore par git.
# =============================================================================
