"""Services module configuration - AutoGen settings (EXAMPLE).

Copy this file to config.py and fill in your actual values.
"""

# ============================================================================
# LLM CONFIGURATION - Choose your AI backend
# ============================================================================

# Use local LLM (Ollama, LM Studio, etc.) instead of cloud APIs
USE_LOCAL_LLM = True

# Local LLM configuration (if USE_LOCAL_LLM = True)
LOCAL_LLM_BASE_URL = "http://localhost:11434"  # Ollama default
LOCAL_LLM_MODEL = "llama3.2"  # or "mistral", "codellama", etc.

# OpenAI configuration (if USE_LOCAL_LLM = False)
OPENAI_API_KEY = "your-openai-api-key-here"
OPENAI_MODEL = "gpt-4"  # or "gpt-3.5-turbo"

# Claude configuration (alternative)
ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
CLAUDE_MODEL = "claude-3-opus-20240229"


# ============================================================================
# AUTOGEN CONFIGURATION
# ============================================================================

# Maximum tokens for agent responses
MAX_TOKENS = 500

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
TEMPERATURE = 0.7

# Timeout for agent responses (seconds)
AGENT_TIMEOUT = 30.0

# Enable agent conversation logging
ENABLE_LOGGING = True

# Logging directory
LOG_DIR = "logs/agents"


# ============================================================================
# AGENT-SPECIFIC SETTINGS
# ============================================================================

# Prompt Agent - Optimizes text for AI prompts
PROMPT_AGENT_CONFIG = {
    "temperature": 0.5,
    "max_tokens": 300,
    "system_message": "You are an expert at reformulating text into clear, effective AI prompts."
}

# Email Agent - Formats text as professional emails
EMAIL_AGENT_CONFIG = {
    "temperature": 0.7,
    "max_tokens": 500,
    "system_message": "You are an expert at writing professional, well-formatted emails."
}

# Grammar Agent - Corrects spelling and grammar
GRAMMAR_AGENT_CONFIG = {
    "temperature": 0.3,
    "max_tokens": 400,
    "system_message": "You are an expert at correcting grammar and spelling while preserving meaning."
}


# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Cache agent responses to avoid redundant API calls
ENABLE_CACHE = True

# Cache expiration time (seconds)
CACHE_EXPIRATION = 3600  # 1 hour

# Maximum concurrent agent requests
MAX_CONCURRENT_REQUESTS = 3
